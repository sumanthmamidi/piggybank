    ('Health',            'SPENDS',      'NEED', 50),
    ('Bank charges',      'SPENDS',      'NEED', 60),
    ('Food delivery',     'SPENDS',      'WANT', 70),
    ('Cafés',             'SPENDS',      'WANT', 80),
    ('Shopping',          'SPENDS',      'WANT', 90),
    ('Entertainment',     'SPENDS',      'WANT', 100),
    ('Mutual fund SIP',   'INVESTMENTS', NULL,   200),
    ('Stocks',            'INVESTMENTS', NULL,   210),
    ('Self-transfer',     'EXCLUDED',    NULL,   300),
    ('Card bill payment', 'EXCLUDED',    NULL,   310),
    ('Wallet top-up',     'EXCLUDED',    NULL,   320);

selectActive:
SELECT * FROM category WHERE archived = 0 ORDER BY sort, name;

selectByTopLevel:
SELECT * FROM category WHERE archived = 0 AND top_level = ? ORDER BY sort, name;

insert:
INSERT INTO category(name, top_level, default_need_want, icon, sort) VALUES (?, ?, ?, ?, ?);

selectById:
SELECT * FROM category WHERE id = ?;

selectByName:
SELECT * FROM category WHERE name = ?;

selectByNameNoCase:
SELECT * FROM category WHERE lower(name) = lower(?);

nextSort:
SELECT coalesce(max(sort), 0) + 10 FROM category WHERE top_level = ?;

unarchive:
UPDATE category SET archived = 0 WHERE id = ?;

lastInsertId:
SELECT last_insert_rowid();
