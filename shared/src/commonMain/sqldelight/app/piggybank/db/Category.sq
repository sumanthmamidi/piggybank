-- Categories sit under one top level. Only SPENDS counts toward spends; EXCLUDED is never counted.
CREATE TABLE category (
    id                INTEGER PRIMARY KEY AUTOINCREMENT,
    name              TEXT    NOT NULL UNIQUE,
    top_level         TEXT    NOT NULL CHECK (top_level IN ('SPENDS', 'INVESTMENTS', 'EXCLUDED')),
    default_need_want TEXT    CHECK (default_need_want IN ('NEED', 'WANT')),
    icon              TEXT,
    sort              INTEGER NOT NULL DEFAULT 0,
    archived          INTEGER NOT NULL DEFAULT 0 CHECK (archived IN (0, 1))
);

-- Starter categories, created with a new database. The user can rename, add or archive.
INSERT INTO category(name, top_level, default_need_want, sort) VALUES
    ('Rent',              'SPENDS',      'NEED', 10),
