-- Your own bank accounts, cards and wallets. Used to spot self-transfers and card bill payments.
CREATE TABLE account (
    id          INTEGER PRIMARY KEY AUTOINCREMENT,
    kind        TEXT    NOT NULL CHECK (kind IN ('BANK', 'CARD', 'WALLET')),
    institution TEXT    NOT NULL,
    last4       TEXT,
    nickname    TEXT,
    is_own      INTEGER NOT NULL DEFAULT 1 CHECK (is_own IN (0, 1))
);

insert:
INSERT INTO account(kind, institution, last4, nickname, is_own) VALUES (?, ?, ?, ?, ?);

selectAll:
SELECT * FROM account ORDER BY institution, last4;

selectOwnByLast4:
SELECT * FROM account WHERE is_own = 1 AND last4 = ?;

selectByInstitutionLast4:
SELECT * FROM account WHERE institution = ? AND last4 = ? AND kind = ?;

lastInsertId:
SELECT last_insert_rowid();

selectById:
SELECT * FROM account WHERE id = ?;

selectOwnLast4:
SELECT DISTINCT last4 FROM account WHERE is_own = 1 AND last4 IS NOT NULL;
